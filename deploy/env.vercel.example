# 9Router on Vercel + MongoDB — environment variables
# Set these in the Vercel dashboard: Project → Settings → Environment Variables.
# (This file is a reference sheet; Vercel does not read it automatically.)

# ─── Required ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas: Connect → Drivers → Node.js).
# Sensitive — do NOT commit. Example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Dashboard login password (upstream default is 123456 — you MUST set a real
# one for a public deployment).
INITIAL_PASSWORD=

# JWT signing secret. Generate with:  openssl rand -base64 32
JWT_SECRET=

# ─── Optional (sane defaults are preconfigured) ─────────────────────────────
# MongoDB database name (default: 9router)
# MONGODB_DB=9router

# Where the app keeps transient files on Vercel (only /tmp is writable).
# Already set for you in vercel.json — override only if you know why.
# DATA_DIR=/tmp/9router

# Additional hardening salt for machine IDs (optional)
# MACHINE_ID_SALT=pick-a-random-string

# Public base URL of this deployment, e.g. https://your-app.vercel.app
# (used by internal cloud-sync jobs; harmless to leave unset)
# BASE_URL=https://your-app.vercel.app
